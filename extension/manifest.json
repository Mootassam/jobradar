{
  "manifest_version": 3,
  "name": "JobRadar Autofill",
  "version": "1.0.1",
  "description": "Fills job application forms from your JobRadar profile and CV. You always review and click Submit yourself.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "JobRadar Autofill - fill this application (Alt+Shift+F)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Fill the application form on this page" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
